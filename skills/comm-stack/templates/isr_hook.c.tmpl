/**
 * 模板：串口 ISR 接线
 *
 * 占位符：
 *   {{LINK}}    链路小写短名
 *   {{HUART}}   HAL 串口句柄，如 huart3
 *   {{USARTX}}  外设实例名，如 USART3
 *
 * 放置位置：CubeMX 生成的 usart.c 的 USER CODE 区，或你自己的 bsp_uart.c。
 *
 * 与框架 v1 的区别：这里不再需要"一个 idle 包必须恰好是一帧"。
 * 解帧完全由 comm_framer 的字节流状态机负责，ISR 只管把收到的字节原样倒进去。
 * 因此 DMA 半满中断（HT）也可以照喂，不必像 v1 那样关掉。
 */

/* ============================================================================
 * 1) DMA 接收启动 —— 在串口初始化之后调用一次
 * ============================================================================ */

#define {{LINK_UPPER}}_RX_DMA_SIZE   64U     /* 与帧长无关，只是一次搬运的粒度 */

static uint8_t s_au8{{LINK}}RxDma[{{LINK_UPPER}}_RX_DMA_SIZE];

/**
 * @brief  启动 {{USARTX}} 的 IDLE + DMA 接收
 */
void {{LINK}}_rx_start(void)
{
    HAL_UARTEx_ReceiveToIdle_DMA(&{{HUART}}, s_au8{{LINK}}RxDma,
                                 {{LINK_UPPER}}_RX_DMA_SIZE);
}

/* ============================================================================
 * 2) 接收事件回调 —— 把字节喂给链路，然后立刻重启 DMA
 * ============================================================================ */

/**
 * @brief  UART 接收事件回调（IDLE 或 DMA 传输完成）
 * @param  [in] huart 触发回调的串口句柄
 * @param  [in] Size  本次收到的字节数
 * @note   运行在中断上下文。CommLink_FeedFromISR 内部是无锁环形缓冲，
 *         不调用任何 RTOS API，因此这里不需要 portYIELD_FROM_ISR；
 *         若配置了 pfNotifyFromISR，唤醒动作在那个回调里自行处理
 */
void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
{
    if (huart->Instance == {{USARTX}})
    {
        CommLink_FeedFromISR(g_pst{{LINK}}Link, s_au8{{LINK}}RxDma, Size);
        HAL_UARTEx_ReceiveToIdle_DMA(&{{HUART}}, s_au8{{LINK}}RxDma,
                                     {{LINK_UPPER}}_RX_DMA_SIZE);
    }
    /* 多串口时在这里继续 else if，每个 USARTx 喂给自己的链路实例。
     * 接错端口是本框架最典型的静默失败：链路永远收不到帧，
     * 而 stats 里 u32RxFrames 恒为 0 —— 排查时先看这个计数。 */
}

/* ============================================================================
 * 3) 发送完成回调 —— 只有用到 pfRespTxDone 时才需要
 * ============================================================================ */

/**
 * @brief  UART 发送完成回调
 * @param  [in] huart 触发回调的串口句柄
 * @note   仅当链路配置了 pfRespTxDone（如"ACK 发完再复位进 Bootloader"）时才必需。
 *         没有该需求可以整段删掉
 */
void HAL_UART_TxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == {{USARTX}})
    {
        CommLink_OnTxComplete(g_pst{{LINK}}Link);
    }
}
